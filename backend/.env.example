# ─── App ───────────────────────────────────────────
APP_NAME=reservas-backend
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=              # openssl rand -hex 32
DEBUG=true

# ─── Base de datos ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://reservas:reservas@localhost:5432/reservas_db
DATABASE_POOL_SIZE=10

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / JWT ────────────────────────────────────
JWT_SECRET_KEY=              # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ──────────────────────────────────────
# URL pública del frontend. Usada para construir enlaces en emails
# (confirmación, recordatorio y carga de documentos de viajeros /g/<token>).
FRONTEND_URL=http://localhost:3000

# Credenciales SES (parte de viajeros, Ministerio del Interior):
# se configuran POR EMPRESA en el panel y se almacenan cifradas en la BD.
# No se gestionan por variables de entorno.
